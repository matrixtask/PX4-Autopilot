# first FW turn (SITL run 4). Previous 28/33 completed the transition below the 37 m/s stall.
param set-default VT_ARSP_BLEND 33
param set-default VT_ARSP_TRANS 50
param set-default VT_B_TRANS_DUR 80  # 72 -> 10 m/s at 1.0 m/s^2 = 62 s; ending on time at 30 m/s left MC braking at 23 deg pitch (WK01 run 8)
param set-default VT_TYPE 2

# ============================================
# Mission envelope (design values; previously injected at runtime by tetra_mk7_profile_smooth.py)
# ============================================
# Airspeeds [m/s]: clean stall 37 (DRO 72.5 KCAS), cruise 72 (140 kt), VNE 82 (160 kt).
param set-default FW_AIRSPD_STALL 37
param set-default FW_AIRSPD_MIN 42
param set-default FW_AIRSPD_TRIM 60
param set-default FW_AIRSPD_MAX 80
# Roll setpoint slew (default 90 deg/s): the turn to the first leg started as a 0 -> -9 deg step at the end of the
# front transition and overshot to -13.6 deg (11/02). 10 deg/s: 20 deg bank in 2 s.
param set-default FW_PN_R_SLEW_MAX 10
param set-default FW_R_LIM 25  # roll demand must not saturate (limit cycle at 15 deg); acceptance <= 30 deg
param set-default FW_YD_GAIN 5.0
param set-default MIS_DIST_1WP 0
# Wing->rotor lift handoff (firmware feature from mk7 study, previously enabled only at runtime by the
# offboard script). Rotors carry the wing's lift deficit, floor = 1-(CAS/72)^2: 0.68 of hover at 41 m/s.
# Without it WK01 run 2 sank 20 m in the blend and quad-chuted. VT_LIFT_HND_THR = hover thrust (EM3 0.42) so the
# rotors carry exactly the wing's lift deficit (quadratic thrust model, see THR_MDL_FAC).
param set-default VT_LIFT_HND_V 72
param set-default VT_LIFT_HND_THR 0.42
# 11/02 (Tasuku: 前方遷移の終わりで揺れる / フェーズ間を滑らかに): rotor -> wing handover after the front transition.
# The climbing transition leaves the rotors at ~0.58; stepping (v5) or fading them linearly (VT_LIFT_HND_RT, v6/v7) to the
# 0.22 schedule sank the vehicle 1.8-3.6 m/s, and the schedule was cut 0.21 -> 0 in one step 25 s after FW entry (nz 0.65).
# Now: slew at <= 0.08/s from the end-of-transition value to the schedule and then to 0, plus a climb-rate assist of
# 0.04 per m/s of TECS climb-rate error weighted by the remaining rotor share (Veronte: vertical-speed loop on the
# rotors fades with sigma, path-angle loop on the wing takes over).
param set-default VT_LIFT_HND_SLW 0.03  # 0.08 (v8): 0.63 -> 0.37 in 3 s and 0.22 -> 0 in 2.7 s still sank 1.5 m/s; the wing needs ~4 deg more AoA (TECS pitch is slow)
param set-default VT_LIFT_HND_KV 0.04
# CCV feed-forward (11/02, Tasuku: ローター制御に対して FF): the pitch setpoint rises with the rotor share released after
# the front transition. 4.8 deg = lift-dependent AoA for the full weight at 72 m/s, from HQ01 v7 (pitch 4.5 deg level at
# 72 m/s, 11 deg climbing 3 m/s at 55 m/s without rotors: alpha = -0.26 + 24700 / V^2 deg). At 55 m/s and 0.52 share: 4.3 deg.
param set-default VT_LIFT_HND_AOA 4.8
# Airspeed schedule (Veronte sigma): filtered CAS (tau 2 s) drives every rotor/wing schedule; rotor weight in the
# front transition changes at <= 0.2/s.
param set-default VT_SIG_TAU 2.0
param set-default VT_SIG_RATE 0.2
# Transition altitude-loss abort = EM3 requirement (+-15 m around the target altitude during transitions).
param set-default VT_QC_T_ALT_LOSS 15
param set-default RTL_TYPE 3

# ============================================
# Operating profile: climbing / descending transitions and passenger-comfort limits (EM3)
# ============================================
# Source: route evaluation "optimizer_model_1410" (teTra HQ -> Fukushima, 849.5 s): 30 m vertical, then climb
# while accelerating (<= 7 m/s, 0.03-0.15 g), cruise 140 kt, wing-borne descent <= 7 m/s, brake 0.1 g while
# descending, sink tapered to 1.4 m/s below 30 kt, vertical landing from 30 m above the pad.
param set-default VT_F_TRANS_VZ 7.0  # climb during the front transition (new, FlightTaskTransition); evaluation 7 m/s. 5 m/s left 135 m AGL at 1.3 km (test 1)
param set-default MPC_Z_VEL_MAX_UP 7.0  # caps the transition climb; MC take-off speed stays MPC_TKO_SPEED
param set-default VT_B_TRANS_VZ 7.0  # descend during the back transition above 50 kt (new; evaluation 7 m/s)
param set-default VT_B_TRANS_VZLO 3.0  # below 30 kt: 0.23 vh (vh 13 m/s). V-22 limit 800 fpm below 40 KTAS = 0.20 vh, VRS onset ~2000 fpm = 0.5 vh
param set-default VT_B_TRANS_HMIN 30  # level off 30 m above the pad, then vertical landing
param set-default VT_B_DEC_MSS 2.0  # 0.2 g braking: back-transition-only sim optimum (mk7_mission tools/bt_sim.py; 0.25 g overshot 47 m at +-20 % model error)
param set-default VT_B_DEC_I 0.3  # with VT_BFF_EN: decel trim gain [1/s] on top of the feed-forward (0 left 120 m overshoot at +-20 % model error)
param set-default FW_T_CLMB_R_SP 3.0  # auto climb rate = what the pusher can do with the evaluation drag (3.3 m/s at full throttle, 53 m/s, test_ff_1)
param set-default FW_T_CLMB_MAX 3.5  # TECS performance model: max climb at trim speed, full throttle
# Final descent into the 3 km arrival zone (11/02, Tasuku: 降下を増やす): 10 m/s = sink at idle and trim speed
# (FW_T_SINK_MIN), no overspeed; the route plans 0.8 x this (1/9). Ends the back transition near pad + 30 m instead of
# pad + 115 m (HQ01: vertical descent 54.7 -> ~5 s).
param set-default FW_T_SINK_R_SP 12.0  # auto descent rate (was 7)
param set-default FW_T_SINK_MAX 13.0   # (was 8)
# Smooth phase changes in FW (11/02, Tasuku: フェーズ間の急峻な変化): the TECS altitude reference had no jerk limit and
# FW_T_VERT_ACC 7 m/s^2, so every waypoint switch stepped the height-rate setpoint (0 <-> -10 m/s in ~2 s, nz 0.55-1.45 g,
# pusher 0.2 <-> 1.0). Reference S-curve at 0.15 g / 0.075 g/s (evaluation comfort limit 0.03-0.15 g); FW_T_VERT_ACC keeps
# limiting the pitch rate only. Each leg is flown as a straight glide path (no step-hold-step at short legs).
