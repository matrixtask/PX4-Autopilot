# within 2 min; terrain-only: 8.3-8.5 deg (runs slope8 / slope8b).
param set-default EKF2_RNG_A_HMAX 1
param set-default EKF2_RNG_POS_X 0.6
param set-default EKF2_RNG_POS_Z 0.46
param set-default EKF2_MIN_RNG 0.2
param set-default EKF2_RNG_NOISE 0.1
